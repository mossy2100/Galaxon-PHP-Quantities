{
    "name": "oceanmoon/quantities",
    "description": "Contains classes for working with measurements such as angles, lengths, etc.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-simplexml": "*",
        "oceanmoon/core": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "oceanmoon/coding-standard": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "OceanMoon\\Quantities\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OceanMoon\\Quantities\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "fix": "vendor/bin/phpcbf -vp",
        "check": "vendor/bin/phpcs -s",
        "report": "vendor/bin/phpcs -q --report=summary",
        "analyze": "scripts/analyze",
        "test:unit": "scripts/test unit",
        "test:currencies": "scripts/test currencies",
        "test": "scripts/test",
        "coverage": "php8.4 scripts/coverage-check.php",
        "quality": [
            "@fix",
            "@check",
            "@analyze",
            "@test",
            "@coverage"
        ]
    },
    "extra": {
        "phpcodesniffer-search-depth": 3
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.4.0"
        }
    }
}
