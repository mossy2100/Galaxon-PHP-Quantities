<?xml version="1.0"?>
<ruleset name="OceanMoon">
    <description>Coding standard for the OceanMoon packages by Shaun Moss.</description>

    <!-- Paths to check -->
    <file>src</file>
    <file>tests</file>

    <!-- Exclude generated data files -->
    <exclude-pattern>src/Currencies/data</exclude-pattern>

    <!-- Use OceanMoon PHP Coding Standard (includes PSR12 + additional rules) -->
    <rule ref="OceanMoon"/>

</ruleset>
